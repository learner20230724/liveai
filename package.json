{
  "name": "liveai",
  "version": "3.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "deploy": "python3 scripts/deploy.py",
    "deploy:web": "python3 scripts/deploy.py",
    "build:apk": "bash scripts/build-apk.sh",
    "test:android": "./android/gradlew -p android :app:testDebugUnitTest --offline --console=plain",
    "publish:apk": "python3 scripts/publish-apk.py",
    "test:ui": "npm run build && node scripts/check-parallel-tools.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^6.4.2",
    "playwright": "1.63.0"
  }
}
